<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPIRA - Equipment Rental Steps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --primary-color: #4a47a3;
            --secondary-color: #706fd3;
            --accent-color: #34ace0;
            --text-color: #23272f;
            --bg-color: #23272f;
            --light-gray: #2c2f36;
            --white: #fff;
            --border-color: #444;
        }
        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg-color);
            margin: 0;
            color: var(--text-color);
        }
        .container {
            max-width: 900px;
            margin: 40px auto;
            background: var(--white);
            border: 2px solid var(--border-color);
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(44,47,54,0.07);
            display: flex;
            min-height: 500px;
        }
        .steps-sidebar {
            background: var(--light-gray);
            border-right: 2px solid var(--border-color);
            padding: 32px 0 32px 0;
            width: 120px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
        }
        .step-btn {
            width: 80px;
            padding: 10px 0;
            margin-bottom: 8px;
            background: var(--white);
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 6px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s, color 0.2s;
        }
        .step-btn.active, .step-btn:focus {
            background: var(--primary-color);
            color: var(--white);
        }
        .main-step-content {
            flex: 1;
            padding: 40px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
        }
        .step-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 18px;
            text-align: center;
        }
        .step-textarea {
            width: 100%;
            min-width: 320px;
            max-width: 420px;
            min-height: 120px;
            border: 2px solid var(--primary-color);
            border-radius: 6px;
            padding: 12px;
            font-size: 1rem;
            margin-bottom: 18px;
            resize: vertical;
        }
        .samples-list {
            width: 100%;
            max-width: 420px;
            margin-bottom: 18px;
        }
        .samples-list input {
            width: 90%;
            padding: 8px;
            margin-bottom: 8px;
            border: 2px solid var(--primary-color);
            border-radius: 4px;
            font-size: 1rem;
        }
        .samples-list label {
            font-weight: 600;
            color: var(--primary-color);
            margin-right: 8px;
        }
        .add-sample-btn {
            background: var(--primary-color);
            color: var(--white);
            border: none;
            border-radius: 4px;
            padding: 7px 18px;
            font-weight: 600;
            cursor: pointer;
            margin-bottom: 12px;
        }
        .add-sample-btn:hover {
            background: var(--secondary-color);
        }
        .submit-btn {
            background: var(--primary-color);
            color: var(--white);
            border: none;
            border-radius: 4px;
            padding: 10px 32px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 18px;
        }
        .submit-btn:hover {
            background: var(--secondary-color);
        }
        .processing {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
        }
        .clock {
            width: 120px;
            height: 120px;
            border: 8px solid var(--primary-color);
            border-radius: 50%;
            position: relative;
            margin-bottom: 18px;
            background: var(--white);
            box-shadow: 0 2px 8px rgba(44,47,54,0.07);
        }
        .clock-hand {
            position: absolute;
            width: 4px;
            height: 48px;
            background: var(--accent-color);
            top: 12px;
            left: 58px;
            border-radius: 2px;
            transform-origin: bottom center;
            animation: spin 2s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .processing-text {
            font-size: 1.1rem;
            color: var(--primary-color);
            margin-bottom: 8px;
            text-align: center;
        }
        .processing-note {
            font-size: 0.95rem;
            color: #888;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="steps-sidebar">
            <button class="step-btn active">Step 1</button>
            <button class="step-btn">Step 2</button>
            <button class="step-btn">Step 3</button>
            <button class="step-btn">Step 4</button>
            <button class="step-btn">Step 5</button>
        </div>
        <div class="main-step-content" id="step-content">
            <!-- Step 1: Describe experiment -->
            <div id="step1">
                <div class="step-title">Kindly describe the experiment conducted</div>
                <textarea class="step-textarea" placeholder="Describe your experiment, methodology, and objectives..."></textarea>
                <button class="submit-btn" onclick="goToStep(2)">Next</button>
                <button class="submit-btn" style="background:#ccc; color:#23272f; margin-left: 10px;" onclick="window.location.href='Listings2.html'">Back</button>
            </div>
            <!-- Step 2: List samples -->
            <div id="step2" style="display:none;">
                <div class="step-title">Kindly list all of the samples required to conduct this experiment</div>
                <form class="samples-list" id="samples-form" onsubmit="event.preventDefault(); goToStep(3);">
                    <div id="samples-inputs">
                        <label>1.</label><input type="text" name="sample1" placeholder="Sample name..."><br>
                        <label>2.</label><input type="text" name="sample2" placeholder="Sample name..."><br>
                        <label>3.</label><input type="text" name="sample3" placeholder="Sample name..."><br>
                    </div>
                    <button type="button" class="add-sample-btn" onclick="addSampleInput()">Add Sample</button><br>
                    <button type="submit" class="submit-btn">Submit</button>
                </form>
                <button class="submit-btn" style="background:#ccc; color:#23272f; margin-top: 10px;" onclick="goToStep(1)">Back</button>
            </div>
            <!-- Step 3: Processing -->
            <div id="step3" style="display:none;">
                <div class="processing">
                    <div class="clock">
                        <div class="clock-hand"></div>
                    </div>
                    <div class="processing-text">Your Order is being Processed!</div>
                    <div class="processing-text">Kindly wait for the University to reach out via Email about the detailed price and specifications of your order!</div>
                    <div class="processing-note">Note: this may take some time depending on the schedule of your selected university.</div>
                </div>
            </div>
            <!-- Step 4: Agree to terms -->
            <div id="step4" style="display:none;">
                <div class="step-title">Terms and Conditions</div>
                <div style="border: 2px solid var(--primary-color); border-radius: 6px; padding: 20px; margin-bottom: 20px; text-align: center; width: 100%; max-width: 420px; color: var(--primary-color); font-weight: 600;">
                    If you agree to the terms and conditions provided by the university for the equipment, then click to proceed to the payment section.
                </div>
                <button class="submit-btn" onclick="goToStep(5)">PROCEED</button>
            </div>
            <!-- Step 5: Payment Details -->
            <div id="step5" style="display:none;">
                <div class="step-title">Purchase Details</div>
                <div style="border: 2px solid var(--primary-color); border-radius: 6px; padding: 20px; margin-bottom: 20px; width: 100%; max-width: 420px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                        <span style="font-weight: 600; color: var(--primary-color);">Cost of Equipment</span>
                        <input type="text" style="width: 100px; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: 4px;" readonly value="$X.XX">
                    </div>
                     <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                        <span style="font-weight: 600; color: var(--primary-color);">Cost of Samples</span>
                        <input type="text" style="width: 100px; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: 4px;" readonly value="$Y.YY">
                    </div>
                     <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                        <span style="font-weight: 600; color: var(--primary-color);">Total tax</span>
                        <input type="text" style="width: 100px; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: 4px;" readonly value="$Z.ZZ">
                    </div>
                     <div style="display: flex; justify-content: space-between; margin-bottom: 20px; border-top: 1px solid var(--border-color); padding-top: 12px;">
                        <span style="font-weight: 700; color: var(--primary-color);">TOTAL</span>
                        <input type="text" style="width: 100px; padding: 4px 8px; border: 1px solid var(--border-color); border-radius: 4px; font-weight: 700;" readonly value="$W.WW">
                    </div>
                    <div style="font-weight: 700; color: var(--primary-color); margin-bottom: 12px; text-align: center;">Mode of Payment</div>
                    <div style="display: flex; justify-content: space-around; gap: 10px;">
                        <button style="padding: 15px; border: 2px solid var(--primary-color); background: var(--white); color: var(--primary-color); border-radius: 6px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 8px;"><i class="fas fa-credit-card fa-2x"></i> CARD</button>
                        <button style="padding: 15px; border: 2px solid var(--primary-color); background: var(--white); color: var(--primary-color); border-radius: 6px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 8px;"><i class="fas fa-qrcode fa-2x"></i> UPI</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        let currentStep = 1;
        const totalSteps = 5;
        const stepButtons = document.querySelectorAll('.step-btn');

        function updateStepUI(step) {
            for (let i = 1; i <= totalSteps; i++) {
                const stepElement = document.getElementById('step' + i);
                if (stepElement) {
                    stepElement.style.display = (i === step) ? '' : 'none';
                }
                if (stepButtons[i - 1]) {
                    stepButtons[i - 1].classList.toggle('active', i === step);
                }
            }
            currentStep = step;
        }

        function goToStep(step) {
            if (step >= 1 && step <= totalSteps) {
                updateStepUI(step);
            }
        }

        stepButtons.forEach((button, index) => {
            button.addEventListener('click', () => {
                goToStep(index + 1);
            });
        });

        let sampleCount = 3;
        function addSampleInput() {
            sampleCount++;
            const div = document.getElementById('samples-inputs');
            const label = document.createElement('label');
            label.textContent = sampleCount + '.';
            const input = document.createElement('input');
            input.type = 'text';
            input.name = 'sample' + sampleCount;
            input.placeholder = 'Sample name...';
            div.appendChild(label);
            div.appendChild(input);
            div.appendChild(document.createElement('br'));
        }

        // Initial UI setup
        updateStepUI(currentStep);

    </script>
</body>
</html>
