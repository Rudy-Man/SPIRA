                <div class="fee-row">
                    <span class="fee-label">Remote access fee</span>
                    <input class="fee-input" type="text">
                </div>
            </div>
        </div>
        <div class="tab-section tab-section1">
            <div class="tabs">
                <button class="tab" onclick="setActiveTab('tab-section1',0)">Equipment Details</button>
                <button class="tab" onclick="setActiveTab('tab-section1',1)">Safety requirements</button>
                <button class="tab" onclick="setActiveTab('tab-section1',2)">Reviews</button>
            </div>
            <div class="tab-content">Equipment details content here...</div>
            <div class="tab-content">Safety requirements content here...</div>
            <div class="tab-content">Reviews content here...</div>
        </div>
        <div class="tab-section tab-section2">
            <div class="tabs">
                <button class="tab" onclick="setActiveTab('tab-section2',0)">Equipment Details</button>
                <button class="tab" onclick="setActiveTab('tab-section2',1)">Safety requirements</button>
                <button class="tab" onclick="setActiveTab('tab-section2',2)">Reviews</button>
            </div>
            <div class="tab-content">Equipment details content here...</div>
            <div class="tab-content">Safety requirements content here...</div>
            <div class="tab-content">Reviews content here...</div>
        </div>
        <div class="feedback-section">
            <div class="feedback-tabs">
                <button class="feedback-tab" onclick="setActiveFeedbackTab(0)">Equipment Details</button>
                <button class="feedback-tab" onclick="setActiveFeedbackTab(1)">Safety requirements</button>
                <button class="feedback-tab" onclick="setActiveFeedbackTab(2)">Reviews</button>
            </div>
            <div class="tab-content">
                <div class="feedback-list">
                    <div class="feedback-item"><span class="feedback-icon"><i class="fas fa-user-circle"></i></span><div class="feedback-line"></div></div>
                    <div class="feedback-item"><span class="feedback-icon"><i class="fas fa-user-circle"></i></span><div class="feedback-line"></div></div>
                    <div class="feedback-item"><span class="feedback-icon"><i class="fas fa-user-circle"></i></span><div class="feedback-line"></div></div>
                    <div class="feedback-item"><span class="feedback-icon"><i class="fas fa-user-circle"></i></span><div class="feedback-line"></div></div>
                </div>
            </div>
            <div class="tab-content" style="display:none;"></div>
            <div class="tab-content" style="display:none;"></div>
        </div>
    </div>
</body>
</html>
